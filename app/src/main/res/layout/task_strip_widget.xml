<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="THE BOARD"
            android:textColor="@color/widget_paper"
            android:textSize="16sp"
            android:textStyle="bold"
            android:typeface="monospace" />

        <TextView
            android:id="@+id/widget_add_button"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/widget_add_button_bg"
            android:gravity="center"
            android:text="+"
            android:textColor="@color/widget_bay_background"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="4dp"
        android:background="#26F4EFE1" />

    <TextView
        android:id="@+id/widget_empty_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="NO STRIPS ON THE BOARD"
        android:textColor="@color/widget_paper_faded"
        android:textSize="12sp"
        android:typeface="monospace"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/widget_row_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <ImageView
            android:id="@+id/widget_row_1_tag"
            android:layout_width="4dp"
            android:layout_height="18dp"
            android:layout_marginEnd="10dp" />

        <TextView
            android:id="@+id/widget_row_1_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/widget_paper"
            android:textSize="13sp"
            android:typeface="monospace" />

        <TextView
            android:id="@+id/widget_row_1_due"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="@color/widget_paper_faded"
            android:textSize="11sp"
            android:typeface="monospace" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_row_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <ImageView
            android:id="@+id/widget_row_2_tag"
            android:layout_width="4dp"
            android:layout_height="18dp"
            android:layout_marginEnd="10dp" />

        <TextView
            android:id="@+id/widget_row_2_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/widget_paper"
            android:textSize="13sp"
            android:typeface="monospace" />

        <TextView
            android:id="@+id/widget_row_2_due"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="@color/widget_paper_faded"
            android:textSize="11sp"
            android:typeface="monospace" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_row_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <ImageView
            android:id="@+id/widget_row_3_tag"
            android:layout_width="4dp"
            android:layout_height="18dp"
            android:layout_marginEnd="10dp" />

        <TextView
            android:id="@+id/widget_row_3_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/widget_paper"
            android:textSize="13sp"
            android:typeface="monospace" />

        <TextView
            android:id="@+id/widget_row_3_due"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="@color/widget_paper_faded"
            android:textSize="11sp"
            android:typeface="monospace" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_row_4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <ImageView
            android:id="@+id/widget_row_4_tag"
            android:layout_width="4dp"
            android:layout_height="18dp"
            android:layout_marginEnd="10dp" />

        <TextView
            android:id="@+id/widget_row_4_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/widget_paper"
            android:textSize="13sp"
            android:typeface="monospace" />

        <TextView
            android:id="@+id/widget_row_4_due"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="@color/widget_paper_faded"
            android:textSize="11sp"
            android:typeface="monospace" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_row_5"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <ImageView
            android:id="@+id/widget_row_5_tag"
            android:layout_width="4dp"
            android:layout_height="18dp"
            android:layout_marginEnd="10dp" />

        <TextView
            android:id="@+id/widget_row_5_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/widget_paper"
            android:textSize="13sp"
            android:typeface="monospace" />

        <TextView
            android:id="@+id/widget_row_5_due"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="@color/widget_paper_faded"
            android:textSize="11sp"
            android:typeface="monospace" />
    </LinearLayout>

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="4dp"
        android:background="#26F4EFE1" />

    <TextView
        android:id="@+id/widget_reminders_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="REMINDERS"
        android:textColor="@color/widget_paper_faded"
        android:textSize="11sp"
        android:textStyle="bold"
        android:typeface="monospace" />

    <TextView
        android:id="@+id/widget_reminders_empty_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="NO REMINDERS SET"
        android:textColor="@color/widget_paper_faded"
        android:textSize="12sp"
        android:typeface="monospace"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/widget_reminder_row_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <ImageView
            android:id="@+id/widget_reminder_row_1_tag"
            android:layout_width="4dp"
            android:layout_height="18dp"
            android:layout_marginEnd="10dp"
            android:background="@color/widget_amber" />

        <TextView
            android:id="@+id/widget_reminder_row_1_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/widget_paper"
            android:textSize="13sp"
            android:typeface="monospace" />

        <TextView
            android:id="@+id/widget_reminder_row_1_due"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="@color/widget_paper_faded"
            android:textSize="11sp"
            android:typeface="monospace" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_reminder_row_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <ImageView
            android:id="@+id/widget_reminder_row_2_tag"
            android:layout_width="4dp"
            android:layout_height="18dp"
            android:layout_marginEnd="10dp"
            android:background="@color/widget_amber" />

        <TextView
            android:id="@+id/widget_reminder_row_2_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/widget_paper"
            android:textSize="13sp"
            android:typeface="monospace" />

        <TextView
            android:id="@+id/widget_reminder_row_2_due"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="@color/widget_paper_faded"
            android:textSize="11sp"
            android:typeface="monospace" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_reminder_row_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <ImageView
            android:id="@+id/widget_reminder_row_3_tag"
            android:layout_width="4dp"
            android:layout_height="18dp"
            android:layout_marginEnd="10dp"
            android:background="@color/widget_amber" />

        <TextView
            android:id="@+id/widget_reminder_row_3_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/widget_paper"
            android:textSize="13sp"
            android:typeface="monospace" />

        <TextView
            android:id="@+id/widget_reminder_row_3_due"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="@color/widget_paper_faded"
            android:textSize="11sp"
            android:typeface="monospace" />
    </LinearLayout>

</LinearLayout>
