<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- The keychain group the iPhone and iPad apps use too. Credential passwords live in it, in
	     iCloud Keychain, so they reach every device. It belongs to the team, not to a bundle id,
	     which is why the Mac can keep com.saud.taskstrip.mac and still share it. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.saud.taskstrip.shared</string>
	</array>
</dict>
</plist>
