<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Mandatory for an extension, and the only entitlement it has. The snapshot it reads is in
	     its own container, put there by the app, so nothing further is needed — see
	     WidgetSnapshot for why an App Group isn't used. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
</dict>
</plist>
